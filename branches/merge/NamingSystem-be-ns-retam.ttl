# - resource -------------------------------------------------------------------

<https://hl7belgium.org/profiles/fhir/terminology/NamingSystem/be-ns-retam> a fhir:NamingSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "be-ns-retam"] ; # 
  fhir:name [ fhir:v "BeRetam"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:kind [ fhir:v "identifier"] ; # 
  fhir:date [ fhir:v "2021-11-17"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "eHealth Platform"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "eHealth Platform" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://www.ehealth.fgov.be" ]
     ] )
  ] [
     fhir:name [ fhir:v "eHealth Platform" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "email" ] ;
       fhir:value [ fhir:v "support@be-ehealth-standards.atlassian.net" ] ;
